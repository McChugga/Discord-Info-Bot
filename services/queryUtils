const stopWords = new Set([
  "about", "after", "again", "also", "and", "any", "are", "can", "could", "does", "find", "for", "from",
  "have", "help", "how", "into", "its", "just", "know", "looking", "please", "some", "tell", "that",
  "the", "their", "them", "there", "these", "this", "those", "what", "when", "where", "which", "who",
  "with", "would", "you", "your"
]);

function extractSearchTerms(text) {
  return [...new Set(String(text || "").toLowerCase().match(/[a-z0-9]{2,}/g) || [])]
    .filter(term => !stopWords.has(term))
    .slice(0, 8);
}

function scoreText(text, terms) {
  const normalized = String(text || "").toLowerCase();
  return terms.reduce((score, term) => score + (normalized.includes(term) ? 1 : 0), 0);
}

module.exports = { extractSearchTerms, scoreText };
